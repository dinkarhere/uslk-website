---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/**
 * Full-bleed section with an optimised background photo and a dark overlay.
 * Used for the page heroes, the volunteer banner and the home donate banner.
 */
interface Props {
  image: ImageMetadata;
  /** 0–1 darkness of the overlay. */
  overlay?: number;
  position?: string | undefined;
  class?: string | undefined;
  as?: "section" | "div";
  labelledby?: string;
  eager?: boolean;
}

const { image, overlay = 0.5, position = "center", class: className, as: Tag = "section", labelledby, eager = false } = Astro.props;
---

<Tag class:list={["banner", className]} aria-labelledby={labelledby} style={`--overlay:${overlay}`}>
  <Image
    src={image}
    alt=""
    class="banner__bg"
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    style={`object-position:${position}`}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
  />
  <div class="banner__content"><slot /></div>
</Tag>

<style>
  .banner { position: relative; isolation: isolate; overflow: hidden; }
  .banner__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .banner::before { content: ""; position: absolute; inset: 0; z-index: -1; background: rgb(0 0 0 / var(--overlay)); }
  .banner__content { position: relative; }
</style>
