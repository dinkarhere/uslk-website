---
import type { ImageMetadata } from "astro";
import BackgroundBanner from "./BackgroundBanner.astro";

interface Props {
  title: string;
  image: ImageMetadata;
  position?: string;
}

const { title, image, position } = Astro.props;
---

<BackgroundBanner image={image} position={position} overlay={0.5} class="page-hero" eager>
  <div class="container">
    <h1>{title}</h1>
  </div>
</BackgroundBanner>

<style>
  .page-hero { padding-block: 100px 70px; }
  .page-hero h1 { color: var(--color-white); }
  @media (max-width: 809px) { .page-hero { padding-block: 70px 50px; } }
</style>
