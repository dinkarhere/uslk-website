---
import { Image } from "astro:assets";
import logo from "@/assets/images/site/logo.png";
import locationIcon from "@/assets/images/site/icon-location.svg";
import phoneIcon from "@/assets/images/site/icon-phone.svg";
import mailIcon from "@/assets/images/site/icon-mail.svg";
import Icon, { type IconName } from "./Icon.astro";
import { getSite, telHref } from "@/lib/content";

const site = await getSite();

const socials = (
  [
    ["facebook", "Facebook"],
    ["instagram", "Instagram"],
    ["twitter", "X (Twitter)"],
    ["linkedin", "LinkedIn"],
  ] as const
)
  .map(([key, label]) => ({ key: key as IconName, label, href: site.social[key] }))
  .filter((s) => s.href);
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" aria-label={`${site.name} — home`}>
          <Image src={logo} alt="" height={68} />
        </a>
        {site.tagline && <p>{site.tagline}</p>}
      </div>

      <address class="footer__contact">
        <div class="item">
          <Image src={locationIcon} alt="" width={25} height={25} />
          <div>
            <p class="item__title">Office</p>
            <p>{site.address}</p>
          </div>
        </div>
        {
          site.phones.map((phone) => (
            <a class="item" href={telHref(phone)}>
              <Image src={phoneIcon} alt="" width={25} height={25} />
              <span class="sr-only">Phone: </span>
              <span>{phone}</span>
            </a>
          ))
        }
        <a class="item" href={`mailto:${site.email}`}>
          <Image src={mailIcon} alt="" width={25} height={25} />
          <span class="sr-only">Email: </span>
          <span>{site.email}</span>
        </a>
      </address>
    </div>

    <div class="footer__bottom">
      <p>{site.copyright}</p>
      {
        socials.length > 0 && (
          <ul class="footer__social" role="list">
            {socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.key} size={22} label={s.label} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer { padding-top: 60px; color: var(--color-body); }
  .footer__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-bottom: 40px; }
  .footer__brand { display: grid; gap: 15px; align-content: start; }
  .footer__brand img { height: 68px; width: auto; }
  .footer__contact { display: grid; gap: 12px; align-content: start; font-style: normal; }
  .item { display: flex; align-items: center; gap: 12px; color: var(--color-black); }
  .item:first-child { align-items: flex-start; }
  .item p + p { margin-top: 6px; color: var(--color-body); }
  .item img { flex: none; opacity: 0.7; }
  .footer__bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 24px; border-top: 1px solid var(--color-light); }
  .footer__social { display: flex; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .footer__social a { color: var(--color-gray); }
  .footer__social a:hover { color: var(--color-primary); }

  @media (max-width: 809px) {
    .footer__grid { grid-template-columns: 1fr; }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
