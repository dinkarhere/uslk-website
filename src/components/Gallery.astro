---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

/**
 * Horizontal photo slider (replaces Framer's Slideshow component).
 * CSS scroll-snap does the work; the buttons are an enhancement.
 */
interface Props {
  images: { image: ImageMetadata; alt: string }[];
  title: string;
}
const { images, title } = Astro.props;
---

{
  images.length > 0 && (
    <section class="gallery" aria-roledescription="carousel" aria-label={`${title} — photos`} data-gallery>
      <ul class="gallery__track" data-track role="list">
        {images.map((g, i) => (
          <li class="gallery__slide" aria-roledescription="slide" aria-label={`${i + 1} of ${images.length}`}>
            <Image
              src={g.image}
              alt={g.alt || `${title} — photo ${i + 1}`}
              widths={[400, 800]}
              sizes="(max-width: 809px) 85vw, 400px"
            />
          </li>
        ))}
      </ul>
      {images.length > 1 && (
        <div class="gallery__controls">
          <button type="button" class="gallery__btn" data-dir="-1">
            <Icon name="chevron-left" size={22} label="Previous photo" />
          </button>
          <button type="button" class="gallery__btn" data-dir="1">
            <Icon name="chevron-right" size={22} label="Next photo" />
          </button>
        </div>
      )}
    </section>
  )
}

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    root.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((btn) =>
      btn.addEventListener("click", () => {
        if (!track) return;
        const slide = track.querySelector<HTMLElement>("li");
        const step = (slide?.offsetWidth ?? track.clientWidth) + 16;
        track.scrollBy({ left: Number(btn.dataset.dir) * step, behavior: "smooth" });
      }),
    );
  }
</script>

<style>
  .gallery { display: grid; gap: 16px; margin-top: 16px; }
  .gallery__track { display: flex; gap: 16px; margin: 0; padding: 0 0 8px; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .gallery__slide { flex: 0 0 min(400px, 85%); scroll-snap-align: start; }
  .gallery__slide img { width: 100%; height: 420px; object-fit: cover; border-radius: 10px; }
  .gallery__controls { display: flex; justify-content: flex-end; gap: 8px; }
  .gallery__btn { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--color-light); border-radius: 50%; background: var(--color-white); color: var(--color-gray); cursor: pointer; }
  .gallery__btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
  @media (max-width: 809px) { .gallery__slide img { height: 320px; } }
</style>
