---
import "@/styles/global.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackgroundBanner from "@/components/BackgroundBanner.astro";
import volunteerBg from "@/assets/images/site/volunteer-banner.jpg";
import defaultSocial from "@/assets/images/site/home-hero.png";
import { getSite } from "@/lib/content";

interface Props {
  /** Page-specific title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image, type = "website", noindex = false } = Astro.props;
const site = await getSite();

const fullTitle = title ? `${title} | ${site.name}` : site.seoTitle;
const metaDescription = description || site.seoDescription;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const social = await getImage({ src: image ?? defaultSocial, width: 1200, height: 630, format: "jpg", fit: "cover" });
const socialUrl = new URL(social.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a80b8" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header email={site.email} phone={site.phones[0]} siteName={site.name} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <BackgroundBanner image={volunteerBg} overlay={0.55} class="volunteer" labelledby="volunteer-title">
      <div class="container volunteer__inner">
        <h2 id="volunteer-title">{site.volunteer.title}</h2>
        <p>{site.volunteer.text}</p>
        <a class="btn btn--red" href="/donate-now">{site.volunteer.ctaLabel}</a>
      </div>
    </BackgroundBanner>

    <Footer />
  </body>
</html>

<style>
  main:focus { outline: none; }
  .volunteer { padding-block: 100px; color: var(--color-white); }
  .volunteer__inner { display: grid; justify-items: center; gap: 25px; max-width: 740px; text-align: center; }
  .volunteer h2 { color: var(--color-white); }
  .volunteer p { line-height: 1.3; }
  @media (max-width: 809px) { .volunteer { padding-block: 70px; } }
</style>
