---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PostCard from "@/components/PostCard.astro";
import BackgroundBanner from "@/components/BackgroundBanner.astro";
import heroImage from "@/assets/images/site/home-hero.png";
import donateBg from "@/assets/images/site/donate-banner.jpg";
import iconWater from "@/assets/images/site/icon-water.svg";
import iconCommunity from "@/assets/images/site/icon-community.svg";
import iconSustainability from "@/assets/images/site/icon-sustainability.svg";
import { getHome, getPosts, getProjects } from "@/lib/content";

const [home, projects, posts] = await Promise.all([getHome(), getProjects(), getPosts()]);
const icons = { water: iconWater, community: iconCommunity, sustainability: iconSustainability };
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      src={heroImage}
      alt=""
      class="hero__bg"
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__inner">
      <div class="hero__content">
        <h1 id="hero-title">{home.hero.title}</h1>
        <p class="hero__subtitle">{home.hero.subtitle}</p>
        <a class="btn btn--primary btn--sm" href="/donate-now">{home.hero.ctaLabel}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="focus-title">
    <div class="container">
      <header class="section-head">
        <h2 id="focus-title">{home.focus.title}</h2>
        <p>{home.focus.text}</p>
      </header>
      <ul class="grid-3 focus" role="list">
        {
          home.focus.items.map((item) => (
            <li class="focus__item">
              <Image src={icons[item.icon]} alt="" width={60} height={60} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section section--accent" aria-labelledby="projects-title">
        <div class="container">
          <header class="section-head">
            <h2 id="projects-title">{home.projects.title}</h2>
            <p>{home.projects.text}</p>
          </header>
          <ul class="grid-3" role="list">
            {projects.slice(0, 3).map((p) => (
              <li>
                <ProjectCard project={p} />
              </li>
            ))}
          </ul>
          <div class="center mt-50">
            <a class="btn btn--primary btn--sm" href="/projects">View All Projects</a>
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="news-title">
        <div class="container">
          <header class="section-head">
            <h2 id="news-title">{home.news.title}</h2>
            <p>{home.news.text}</p>
          </header>
          <ul class="grid-3" role="list">
            {posts.slice(0, 3).map((p) => (
              <li>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
          <div class="center mt-50">
            <a class="btn btn--primary btn--sm" href="/blog">View All News</a>
          </div>
        </div>
      </section>
    )
  }

  <BackgroundBanner image={donateBg} overlay={0} class="donate" labelledby="donate-title">
    <div class="container">
      <div class="donate__card">
        <h2 id="donate-title" class="donate__title">{home.donate.title}</h2>
        <p>{home.donate.text}</p>
        <a class="btn btn--primary btn--sm" href="/donate-now">{home.donate.ctaLabel}</a>
      </div>
    </div>
  </BackgroundBanner>

  <section class="section" aria-labelledby="stats-title">
    <div class="container">
      <header class="section-head">
        <h2 id="stats-title">{home.stats.title}</h2>
      </header>
      <dl class="stats">
        {
          home.stats.items.map((s) => (
            <div class="stat">
              <dt class="stat__label">{s.label}</dt>
              <dd class="stat__value">
                <span data-count-to={s.value}>{s.value}</span>
                {s.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<script>
  // Count-up animation when the numbers scroll into view (Framer "Number Counter").
  // The final value is already in the HTML, so this is purely decorative.
  const els = document.querySelectorAll<HTMLElement>("[data-count-to]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo) || 0;
      const start = performance.now();
      const duration = 1500;
      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            animate(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.5 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; display: flex; align-items: center; min-height: calc(100svh - 162px); padding-block: 60px; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: left bottom; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(111deg, rgb(247 247 247) 7%, rgb(0 200 240 / 0) 56%); }
  .hero__content { display: grid; gap: 20px; justify-items: start; max-width: 560px; }
  .hero h1 { font-size: var(--display); line-height: 0.9; font-weight: 700; color: var(--color-primary); }
  .hero__subtitle { font-size: var(--h4); line-height: 32px; font-weight: 500; color: var(--color-hero-text); }

  .focus { margin: 0; padding: 0; gap: 40px; }
  .focus__item { display: grid; justify-items: center; gap: 15px; padding-inline: 12px; text-align: center; }
  .focus__item img { margin-bottom: 5px; }
  .focus__item h3 { font-size: var(--h4); line-height: 32px; }
  .focus__item p { line-height: 1.3; }

  ul.grid-3 { margin: 0; padding: 0; }

  .donate { padding: 60px var(--gutter); }
  .donate__card { display: grid; gap: 28px; justify-items: center; max-width: 550px; margin-inline: auto; padding: 40px; background: var(--color-white); border-radius: var(--radius); text-align: center; }
  .donate__title { font-size: var(--h3); line-height: 36px; font-weight: 500; }
  .donate__card p { line-height: 1.3; }

  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; margin: 0; }
  .stat { display: flex; flex-direction: column-reverse; align-items: center; gap: 14px; text-align: center; }
  .stat__value { margin: 0; font-size: var(--h2); font-weight: 600; line-height: 1.2; color: var(--color-black); font-variant-numeric: tabular-nums; }
  .stat__label { color: rgb(14 14 14 / 0.6); line-height: 22px; letter-spacing: -0.02em; }

  @media (max-width: 809px) {
    .hero { min-height: 80svh; padding-block: 20px; }
    .hero::before { background: linear-gradient(111deg, rgb(247 247 247 / 0.95) 20%, rgb(0 200 240 / 0) 80%); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
    .donate__card { padding: 30px 20px; }
  }
</style>
