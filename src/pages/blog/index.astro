---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PostCard from "@/components/PostCard.astro";
import LoadMore from "@/components/LoadMore.astro";
import heroImage from "@/assets/images/site/blog-hero.jpg";
import { getPosts } from "@/lib/content";

const posts = await getPosts();
---

<BaseLayout title="Blogs" description="News and stories from USLK Jal Foundation.">
  <PageHero title="Blogs" image={heroImage} />
  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="empty">No posts yet — check back soon.</p>
        ) : (
          <LoadMore pageSize={6} total={posts.length} itemsClass="list">
            {posts.map((p) => (
              <div>
                <PostCard post={p} variant="list" />
              </div>
            ))}
          </LoadMore>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: 90px 100px; }
  .list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 32px; }
  .empty { text-align: center; }
  @media (max-width: 1023px) { .list { grid-template-columns: minmax(0, 1fr); } }
</style>
